# ---- 应用 ----
APP_ENV=dev
APP_DEBUG=true
APP_LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
LANGGRAPH_SERVICE_URL=http://127.0.0.1:8100
# 与 api 共享；生产请改为随机长密钥
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=agent
MYSQL_PASSWORD=agent_pwd
MYSQL_DATABASE=agent_platform
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_ECHO=false

# ---- Redis（会话 / Checkpoint / 缓存 / 限流 / 队列 共用，按 key 前缀隔离）----
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5

# ---- Milvus ----
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=knowledge_chunks
MILVUS_ALIAS=active_collection
MILVUS_DIM=768

# ---- Elasticsearch ----
ES_HOSTS=http://127.0.0.1:9200
ES_INDEX=kb_chunks
ES_REQUEST_TIMEOUT=10

# ---- 摄入 ----
INGEST_QUEUE=queue:ingest:doc
INGEST_MAX_TRIES=3
CHUNK_TOKENS=250
CHUNK_OVERLAP=100
MAX_DOCUMENT_MB=200
